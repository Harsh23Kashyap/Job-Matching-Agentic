flowchart TB
  CP("Candidate portal")
  EP("Employer portal")
  AD("Admin console")

  AUTH("Auth sessions roles")
  RO("ReadOnly middleware")
  API("REST handlers")

  C1("Candidate agent: parse pipeline")
  C2("Candidate agent: profile + snapshot")
  CVS[("Candidate vectors")]
  CACT[("Activity SQLite")]

  E1("Employer agent: parse + live sync")
  E2("Employer agent: job + snapshot + status")
  JVS[("Job vectors")]
  ELIVE("Live jobs sync")

  M1("Matchmaking agent: retrieve + score")
  M2("Matchmaking agent: explain + rank")
  MSESS("Invalidation + session log")

  SQL[("SQLite users feedback activity")]
  BOOT[("Bootstrap JSON cvs jobs")]
  LIVE[("jobs_live snapshot")]

  CAT[("Skill catalog")]
  BUS("Event bus")
  SNAP("Snapshot contracts")
  ML[("fusion calibration models")]

  ACT("Portal save apply dismiss")
  FAPI("feedback actions API")

  CH("Chroma")
  QD("Qdrant")

  CP --> EP --> AD --> AUTH
  AUTH --> RO --> API
  API --> C1 --> C2 --> CVS
  C2 --> CACT
  API --> E1 --> E2 --> JVS
  ELIVE -.-> E1
  LIVE -.-> E1
  BOOT -.-> C2
  BOOT -.-> E2
  API --> SQL
  API --> M1 --> M2
  MSESS -.-> M1
  CP -.-> ACT
  EP -.-> ACT
  ACT --> FAPI --> SQL
  FAPI -.-> M1
  CVS -.-> M1
  JVS -.-> M1
  C2 --> SNAP
  E2 --> SNAP
  C2 -.-> BUS
  E2 -.-> BUS
  BUS -.-> MSESS
  M2 --> API
  CAT --> C1
  CAT --> E1
  ML -.-> M1
  CVS --> CH --> QD
  JVS --> CH

