flowchart TB
  subgraph P1["Phase 1 · Job ingestion"]
    S1("1 Employer: paste / upload JD")
    S2("2 Portal: forward job draft")
    S3("3 Employer agent: parse and extract skills")
    S4("4 Employer agent: job quality check")
    S5("5 Portal: posting form prefill")
    S6("6 Employer: confirm and publish status open")
    S1 --> S2 --> S3 --> S4 --> S5 --> S6
  end

  subgraph P2["Phase 2 · Snapshot and index"]
    S7("7 Portal: job profile + snapshot")
    S8("8 Vector store: upsert job embeddings")
    S9("9 Employer agent: snapshot / invalidation event")
    S7 --> S8 --> S9
  end

  subgraph P3["Phase 3 · Reverse matching"]
    S10("10 Matchmaking agent: read candidates + job vector")
    S11("11 Matchmaking agent: score rank explain")
    S12("12 Portal: ranked candidates + breakdown drawer")
    S10 --> S11 --> S12
  end

  subgraph P4["Phase 4 · Optional similar candidates"]
    S13("13 Employer: open candidate detail optional")
    S14("14 Matchmaking agent: similar candidates read-only")
    S15("15 Portal: related shortlist")
    S13 --> S14 --> S15
  end

  subgraph P5["Phase 5 · User actions"]
    S16("16 Employer: save / reject / contact")
    S17("17 Feedback store: recordFeedbackAction")
    S18("18 Employer: review applicants page")
    S16 --> S17 --> S18
  end

  S6 --> S7
  S9 --> S10
  S12 --> S13
  S12 --> S16
  S15 -.-> S16

  classDef step fill:#fffbeb,stroke:#b45309,color:#78350f,stroke-width:2.5px
  classDef opt fill:#fef3c7,stroke:#d97706,color:#92400e,stroke-width:2.5px

  class S1,S2,S3,S4,S5,S6,S7,S8,S9,S10,S11,S12,S16,S17,S18 step
  class S13,S14,S15 opt
