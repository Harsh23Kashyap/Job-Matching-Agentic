  classDef ml fill:#fffbeb,stroke:#d97706,color:#92400e,stroke-width:2.5px
  classDef metrics fill:#eff6ff,stroke:#2563eb,color:#1e3a8a,stroke-width:2.5px
  classDef audit fill:#fef3c7,stroke:#ca8a04,color:#713f12,stroke-width:2.5px
  classDef gate fill:#faf5ff,stroke:#7c3aed,color:#4c1d95,stroke-width:2.5px
  classDef artifacts fill:#f8fafc,stroke:#64748b,color:#334155,stroke-width:2.5px

  class H_CORP,H_RUN,H_ML,H_MET,H_AUD,H_OUT,H_GATE header
  class CVS,JBS,PAIRS corpus
  class BASE,PROG,ABL,SIG,XPL,CER,NM run
  class TRAIN,MODELS ml
  class P,R,N,LAT metrics
  class FN,FF,LIVE audit
  class EXP,PYT gate
  class TBL,JSON artifacts
