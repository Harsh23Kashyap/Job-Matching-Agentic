flowchart TB
  H_CORP["Frozen demo corpus"]
  CVS("30 resumes")
  JBS("15 jobs")
  PAIRS("47 graded relevance pairs")
  H_CORP --> CVS --> JBS --> PAIRS

  H_RUN["Benchmark drivers"]
  BASE("Baselines TF-IDF BM25 dense")
  PROG("Progression soft-embed fusion composite")
  ABL("Ablations hard negatives")
  SIG("Significance tests")
  XPL("Explainability eval")
  CER("Cross-encoder report")
  NM("Negative mining")
  H_RUN --> BASE --> PROG --> ABL --> SIG
  PROG --> XPL
  PROG --> CER
  ABL --> NM

  H_ML["ML artifacts optional"]
  TRAIN("Train fusion + calibration")
  MODELS[("data/models/")]
  H_ML --> TRAIN
  TRAIN -.-> MODELS

  H_MET["Metrics"]
  P("P@5")
  R("R@5")
  N("nDCG@5")
  LAT("Latency ms/query")
  H_MET --> P --> R --> N --> LAT

  H_AUD["Audits"]
  FN("Hard-negative label check")
  FF("Synthetic fairness audit")
  LIVE("Admin fairness snapshot")
  H_AUD --> FN --> FF
  FF -.-> LIVE

  H_OUT["Artifacts"]
  TBL("Paper tables section 6")
  JSON[("benchmark_outputs/")]
  H_OUT --> TBL
  TBL --> JSON

  H_GATE["Regression gate"]
  EXP("expected baselines JSON")
  PYT("pytest test_eval_regression")
  H_GATE --> EXP --> PYT

  PAIRS --> BASE
  MODELS -.-> PROG
  SIG --> H_MET
  XPL --> P
  CER --> P
  NM --> H_AUD
  LAT --> TBL
  FN --> TBL
  LAT --> JSON
  JSON --> H_GATE
  FF -.-> LIVE

