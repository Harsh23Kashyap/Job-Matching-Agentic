# Copy to .env for local development:
#   cp .env.example .env
# Then fill in real values in .env only. Never commit .env or paste keys into git.
#
# Production: inject these via your platform (Render, Railway, Fly.io, AWS, etc.)
# secret store / environment variables — NOT from a file in the repo.

# -----------------------------------------------------------------------------
# LLM — resume field extraction (candidate onboarding)
# -----------------------------------------------------------------------------
# If OPENAI_API_KEY is set, the backend uses OpenAI (gpt-4o-mini) for parsing.
# If unset, it falls back to local Ollama (ollama serve + llama3.2).
# Local .env overrides any OPENAI_API_KEY already exported in your shell.
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (Azure, LiteLLM, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (used when OPENAI_API_KEY is empty)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
# Required in production — use a long random value from your secret manager.
SESSION_SECRET=dev-change-me

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001

# Auto-create demo.candidate@test.com / demo.employer@test.com / demo.admin@test.com (demo1234)
SEED_DEMO=true

# -----------------------------------------------------------------------------
# Production checklist
# -----------------------------------------------------------------------------
# 1. Set OPENAI_API_KEY and SESSION_SECRET in the host dashboard (encrypted).
# 2. Do not bake secrets into Docker images or frontend bundles.
# 3. Do not add .env to git — it is listed in .gitignore.
# 4. Rotate any key that was ever committed or shared in chat/logs.
